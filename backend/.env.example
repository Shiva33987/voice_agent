# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379

# Deployment
DEPLOYMENT_MODE=oss
OSS_JWT_SECRET=your_32_character_random_jwt_secret_here

# CORS: Add your Vercel URL
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# LLM & Voice Keys (Set whichever you use)
OPENAI_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

